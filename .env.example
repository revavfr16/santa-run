# First Due API Token
FD_TOKEN=your_first_due_api_token_here

# Mapbox Access Token
# Get your token from https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here

# Mapbox Style URL (optional)
# Use your custom style from https://studio.mapbox.com/
# Format: mapbox://styles/YOUR_USERNAME/YOUR_STYLE_ID
# VITE_MAPBOX_STYLE="mapbox://styles/djzager/your-custom-style-id"
