# Mapbox public token, from https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Optional map style. Defaults to a night style.
# VITE_MAPBOX_STYLE=mapbox://styles/YOUR_USERNAME/YOUR_STYLE_ID

# First Due API token
FD_TOKEN=

# First Due device id of the vehicle Santa rides with
FD_DEVICE_ID=822633

# Google sign-in client id for the crew switch at /crew (not a secret).
# Created in Google Cloud console as a Web application client, Internal audience.
VITE_GOOGLE_CLIENT_ID=
